+import{DBadge,DConnectionError,DDataTable,DEmptyState,DLoadingIndicator,type TableColumn}from'@digvation/ui';import{useClientMonitoring}from'../hooks/use-client-monitoring';import type{ClientIncident,ClientSystem}from'../types/client-monitoring';import'../monitoring.css';const V:any={HEALTHY:'success',DEGRADED:'warning',UNHEALTHY:'danger',UNKNOWN:'default',OPEN:'danger',ACKNOWLEDGED:'warning',RESOLVED:'success'};const S:TableColumn<ClientSystem>[]=[{key:'productName',label:'System'},{key:'installationName',label:'Installation'},{key:'environment',label:'Environment'},{key:'health',label:'Health',render:x=><DBadge variant={V[x.health]} dot>{x.health}</DBadge>},{key:'serviceSummary',label:'Service status'},{key:'lastObservedAt',label:'Last observed',render:x=>x.lastObservedAt?new Date(x.lastObservedAt).toLocaleString():'Not observed'}];const I:TableColumn<ClientIncident>[]=[{key:'title',label:'Incident'},{key:'severity',label:'Severity',render:x=><DBadge variant={V[x.severity]??'warning'}>{x.severity}</DBadge>},{key:'status',label:'Status',render:x=><DBadge variant={V[x.status]}>{x.status}</DBadge>},{key:'detectedAt',label:'Detected',render:x=>new Date(x.detectedAt).toLocaleString()}];export function ClientMonitoringPage(){const q=useClientMonitoring();if(q.isPending)return <div className="cm-state"><DLoadingIndicator label="Loading your systems"/></div>;if(q.isError)return <DConnectionError title="Monitoring unavailable" message="Your monitoring status could not be loaded." detail={q.error.message} onRetry={()=>void q.refetch()}/>;const d=q.data;const attention=d.systems.filter(x=>x.health!=='HEALTHY');return <div className="cm-page"><header><p>Client monitoring</p><h1>{d.context.displayName} systems</h1><span>Client-safe status view · read-only</span></header><section><h2>Overall status</h2>{attention.length?<p>{attention.length} system{attention.length>1?'s':''} currently require attention.</p>:<DEmptyState title="All systems healthy" description="No current client-visible incidents."/>}</section><section><h2>Systems</h2><DDataTable columns={S} data={d.systems} rowKey="id"/></section><section><h2>Current incidents</h2>{d.incidents.length?<DDataTable columns={I} data={d.incidents} rowKey="id"/>:<DEmptyState title="No current incidents" description="There are no client-visible incidents affecting your systems."/>}</section></div>}

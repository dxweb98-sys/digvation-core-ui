+import type{ClientMonitoringDataSource}from'./client-monitoring-data-source';import type{ClientMonitoringProjection}from'../types/client-monitoring';const CONTEXT={clientId:'client-nova',displayName:'Nova Salon',permittedInstallationIds:['installation-nova-pos-production','installation-nova-workshop-staging']};const DATA:ClientMonitoringProjection={context:CONTEXT,systems:[{id:'installation-nova-pos-production',productName:'Digvation POS',installationName:'Nova POS Production',environment:'PRODUCTION',applicationUrl:'https://pos.novasalon.digvation.id',health:'HEALTHY',serviceSummary:'All client-visible services healthy',lastObservedAt:'2026-09-07T01:20:00Z',maintenance:false,version:'v0.3.2'},{id:'installation-nova-workshop-staging',productName:'Digvation Workshop',installationName:'Nova Workshop Staging',environment:'STAGING',health:'DEGRADED',serviceSummary:'One background service is degraded',lastObservedAt:'2026-09-07T01:18:00Z',maintenance:true,version:'v0.3.2'}],incidents:[{id:'client-incident-nova-worker',title:'Background processing is delayed',summary:'Some background processing may take longer than usual. Digvation is investigating.',severity:'HIGH',status:'ACKNOWLEDGED',systemId:'installation-nova-workshop-staging',detectedAt:'2026-09-07T01:18:00Z'}]};export function createMockClientMonitoringDataSource():ClientMonitoringDataSource{return{async getMonitoring(){return JSON.parse(JSON.stringify(DATA))}}}
